generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ticketsAsCustomer Ticket[]       @relation("CustomerTickets")
  ticketsAsAgent    Ticket[]       @relation("AgentTickets")
  messages          Message[]
  refreshTokens     RefreshToken[]
  travelProfile     TravelProfile?
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Populated only when status transitions to CLOSED. closedBy is a plain
  // string (not a relation) so a close record survives the closer's account
  // deletion without needing an onDelete behavior of its own.
  closeReason String?
  closedAt    DateTime?
  closedBy    String?

  // Populated only when status transitions back to OPEN from CLOSED. Same
  // single-snapshot pattern as the close fields above — a repeat
  // close/reopen cycle overwrites the previous reopen record rather than
  // preserving history. reopenedBy is a plain string for the same reason
  // as closedBy: survives the reopener's account deletion.
  reopenReason String?
  reopenedAt   DateTime?
  reopenedBy   String?

  customerId  String?
  customer    User?   @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: SetNull)

  agentId     String?
  agent       User?   @relation("AgentTickets", fields: [agentId], references: [id], onDelete: SetNull)

  messages    Message[]
}

model Message {
  id            String   @id @default(cuid())
  content       String
  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelAgency {
  id String @id
  name String
  code String @unique
  bookings TravelBooking[]
  profiles TravelProfile[]
  tickets TravelTicket[]
}

model TravelSupplier {
  id String @id
  name String
  email String
  bookings TravelBooking[]
  profiles TravelProfile[]
  conversations TravelConversation[]
}

model TravelProfile {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind String
  agencyId String?
  agency TravelAgency? @relation(fields: [agencyId], references: [id])
  supplierId String?
  supplier TravelSupplier? @relation(fields: [supplierId], references: [id])
  region String?
  available Boolean @default(true)
  specialties String[] @default([])
}

model TravelBooking {
  id String @id @default(cuid())
  reference String
  agencyId String
  agency TravelAgency @relation(fields: [agencyId], references: [id])
  customerId String
  supplierId String
  supplier TravelSupplier @relation(fields: [supplierId], references: [id])
  destination String
  region String
  service String
  checkInAt DateTime
  departureAt DateTime?
  cancellationCutoffAt DateTime?
  timezone String
  tickets TravelTicket[]
  @@unique([agencyId, reference])
  @@index([customerId])
}

model TravelTicket {
  id String @id @default(cuid())
  reference String @unique
  title String
  description String
  agencyId String
  agency TravelAgency @relation(fields: [agencyId], references: [id])
  customerId String
  bookingId String?
  booking TravelBooking? @relation(fields: [bookingId], references: [id])
  category String
  status String @default("OPEN")
  priority String @default("MEDIUM")
  region String
  agentId String?
  deadline DateTime
  responseDeadline DateTime?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages TravelMessage[]
  conversations TravelConversation[]
  events TravelEvent[]
  @@index([agencyId, customerId])
  @@index([status, deadline])
}

model TravelConversation {
  id String @id @default(cuid())
  ticketId String
  ticket TravelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  supplierId String
  supplier TravelSupplier @relation(fields: [supplierId], references: [id])
  subject String
  status String @default("AWAITING_REPLY")
  dueAt DateTime
  createdAt DateTime @default(now())
  messages TravelMessage[]
  @@index([supplierId])
}

model TravelMessage {
  id String @id @default(cuid())
  ticketId String
  ticket TravelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation TravelConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId String
  visibility String
  content String
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}

model TravelEvent {
  id String @id @default(cuid())
  ticketId String
  ticket TravelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind String
  text String
  actorId String
  uniqueKey String? @unique
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}

model TravelClock {
  id String @id
  offsetMinutes Int @default(0)
}

// Track the development counter table in migrations as well as using it through pg.
// This prevents schema-drift prompts when developers add future Prisma migrations.
model OpsCounter {
  key String @id
  value String
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
}
